{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=../../apps/spendwise/.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=../../apps/spendwise/.env.local --import tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:",
    "@repo/finance": "workspace:*",
    "drizzle-orm": "catalog:",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "date-fns": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
