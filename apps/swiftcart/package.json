{
  "name": "@repo/swiftcart",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/reset.ts",
    "media:mirror": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/mirror.ts",
    "db:seed": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "env:report": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/env-report.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@neondatabase/auth": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@repo/shared": "workspace:*",
    "@repo/ui": "workspace:*",
    "drizzle-orm": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@repo/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
