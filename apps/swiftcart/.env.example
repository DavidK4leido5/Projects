# Neon EMITS EXACTLY THESE (see `neon env pull`). Put them in .env or .env.local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# The bucket is NOT an env var. It is declared in neon.ts and defaults to "assets".
# Override only if you provisioned a differently named bucket.
# OBJECT_STORAGE_BUCKET=assets

# Verify what the app resolves (values masked):
#   pnpm --filter @repo/swiftcart env:report
# Cloudinary: images are mirrored here for responsive delivery and CDN.
# The bucket stays the system of record. Uploads go into the "swiftcart" folder.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
