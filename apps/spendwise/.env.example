# Postgres (Neon). `neon deploy` writes both into .env.local.
# Use the pooled URL for the app and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth). Enable with `auth: true` in neon.ts.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (S3-compatible). Injected by `neon deploy`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# Bucket declared in neon.ts. Not injected by Neon.
OBJECT_STORAGE_BUCKET=assets

# Cloudinary (report logo delivery). Reused from the SwiftCart project.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Public origin used for canonical URLs, sitemap, robots, and Open Graph metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional
NEXT_PUBLIC_APP_NAME=SpendWise